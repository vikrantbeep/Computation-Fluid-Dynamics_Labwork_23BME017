    comments=""
)

# ================================================================
# 13. STRouHAL NUMBER CALCULATION
# ================================================================

LIFT_HISTORY = HISTORY[:, 4]

STROUHAL = 0.0

if len(LIFT_HISTORY) >= 64:

    START = len(LIFT_HISTORY) // 2

    SIGNAL = (
        LIFT_HISTORY[START:]
        - np.mean(LIFT_HISTORY[START:])
    )

    if np.std(SIGNAL) >= 1e-5:

        SPECTRUM = np.abs(
            np.fft.rfft(
                SIGNAL * np.hanning(len(SIGNAL))
            )
        )**2

        FREQUENCY = np.fft.rfftfreq(
            len(SIGNAL),
            d=SUBSTEPS
        )

        ST_VALUES = (
            FREQUENCY
            * DIAMETER
            / INLET_SPEED
        )

        VALID = (
            (ST_VALUES >= 0.05)
            & (ST_VALUES <= 0.35)
        )

        if np.any(VALID):

            STROUHAL = ST_VALUES[VALID][
                np.argmax(SPECTRUM[VALID])
            ]

# ================================================================
