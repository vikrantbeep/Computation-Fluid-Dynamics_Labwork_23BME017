        }

        for NAME, FIELD in FIELDS.items():

            HANDLE.write(
                f"SCALARS {NAME} float 1\n"
            )

            HANDLE.write(
                "LOOKUP_TABLE default\n"
            )

            for VALUE in FIELD.ravel():

                HANDLE.write(
                    f"{VALUE:.8e}\n"
                )

        HANDLE.write(
            "VECTORS velocity_lattice float\n"
        )

        for VX, VY in zip(
            UX.ravel(),
            UY.ravel()
        ):

            HANDLE.write(
                f"{VX:.8e} {VY:.8e} 0\n"
            )

save_final_vtk()

# ================================================================
# 11. SAVE CYLINDER GEOMETRY
# ================================================================

THETA = np.linspace(
    0,
    2 * np.pi,
    361
)

WALL_X = (
    CENTER_X / DIAMETER
    + 0.5 * np.cos(THETA)
)

WALL_Y = (
