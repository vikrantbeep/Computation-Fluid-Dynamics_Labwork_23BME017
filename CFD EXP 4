    HANDLE.write(f"Cylinder diameter: {DIAMETER}\n")
    HANDLE.write(f"Inlet velocity: {INLET_SPEED}\n")
    HANDLE.write(f"Kinematic viscosity: {NU}\n")
    HANDLE.write(f"Relaxation time: {TAU}\n")

    HANDLE.write(
        f"Estimated Strouhal number: {STROUHAL:.8f}\n"
    )

    HANDLE.write(
