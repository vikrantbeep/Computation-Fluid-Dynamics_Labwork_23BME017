                    f"{PHYSICAL_Y[Y,X]:.8e} 0\n"
                )

        HANDLE.write(
            f"POINT_DATA {NX * NY}\n"
        )

        FIELDS = {
            "pressure_lbm": PRESSURE,
            "density": np.where(FLUID, RHO, 1.0),
            "vorticity_nondimensional": VORTICITY,
            "solid_mask": SOLID.astype(float),
