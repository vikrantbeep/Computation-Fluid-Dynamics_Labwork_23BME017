# ================================================================
# 10. MAIN TIME-STEPPING LOOP
# ================================================================

TIME = 0.0
STEP = 0

HISTORY = []

SNAPSHOT_TIMES = [0.0]

SNAPSHOT_ETA = [
    ETA_LW.copy()
]

print("\nStarting numerical simulation...\n")

while TIME < END_TIME - 1e-14:

    DT = min(
        DT_NOMINAL,
        END_TIME - TIME
    )

    COURANT = (
        WAVE_SPEED * DT / DX
    )

    # ------------------------------------------------------------
    # UPWIND METHOD
    # ------------------------------------------------------------

    WP_UPWIND = upwind(
        WP_UPWIND,
        COURANT
    )

    WM_UPWIND = upwind(
        WM_UPWIND,
        -COURANT
    )

    # ------------------------------------------------------------
    # LAX-WENDROFF METHOD
    # ------------------------------------------------------------

    WP_LW = lax_wendroff(
        WP_LW,
        COURANT
    )

    WM_LW = lax_wendroff(
        WM_LW,
        -COURANT
    )

    # Update time

    TIME += DT
    STEP += 1

    # ------------------------------------------------------------
    # RECONSTRUCT PHYSICAL VARIABLES
    # ------------------------------------------------------------

    ETA_UPWIND, U_UPWIND = reconstruct(
        WP_UPWIND,
        WM_UPWIND,
        DEPTH,
        WAVE_SPEED
    )

    ETA_LW, U_LW = reconstruct(
        WP_LW,
        WM_LW,
        DEPTH,
        WAVE_SPEED
    )

    # ------------------------------------------------------------
    # ANALYTICAL REFERENCE
    # ------------------------------------------------------------

    ETA_REFERENCE = analytical_eta(
        X,
        TIME,
        WAVE_SPEED,
        AMPLITUDE,
        CENTER,
        SIGMA
    )

    # ------------------------------------------------------------
    # ERROR CALCULATIONS
    # ------------------------------------------------------------

    ERROR_UPWIND = relative_l2(
        ETA_UPWIND,
        ETA_REFERENCE
    )

    ERROR_LW = relative_l2(
        ETA_LW,
        ETA_REFERENCE
    )

    # ------------------------------------------------------------
    # MASS CONSERVATION
    # ------------------------------------------------------------

    MASS_UPWIND = trapezoidal_integral(
        ETA_UPWIND,
        X
    )

    MASS_LW = trapezoidal_integral(
        ETA_LW,
        X
    )

    # ------------------------------------------------------------
    # SAVE HISTORY
    # ------------------------------------------------------------

    HISTORY.append([
        STEP,
        TIME,
        DT,
        COURANT,
        ERROR_UPWIND,
        ERROR_LW,
        MASS_UPWIND,
        MASS_LW
    ])

    # Numerical stability check

    if not (
        np.all(np.isfinite(ETA_UPWIND))
        and np.all(np.isfinite(ETA_LW))
    ):

        raise FloatingPointError(
            f"Non-finite solution at step {STEP}"
        )

    # ------------------------------------------------------------
    # PROGRESS OUTPUT
    # ------------------------------------------------------------

    if (
        STEP % max(1, OUTPUT_EVERY) == 0
        or TIME >= END_TIME - 1e-14
    ):

        print(
            f"Step {STEP:5d} | "
            f"Time {TIME:.5f} | "
            f"CFL {COURANT:.4f} | "
            f"Upwind error {ERROR_UPWIND:.6e} | "
            f"LW error {ERROR_LW:.6e}"
        )

        SNAPSHOT_TIMES.append(TIME)

        SNAPSHOT_ETA.append(
            ETA_LW.copy()
        )


