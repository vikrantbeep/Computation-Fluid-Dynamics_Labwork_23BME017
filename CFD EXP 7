# ================================================================
# 12. VTK STRUCTURED GRID WRITER
# ================================================================

def write_structured_grid_vtk(
    path,
    x,
    y,
    scalars=None,
    vectors=None,
    title="Shallow water output"
):

    x = np.asarray(x, dtype=float)
    y = np.asarray(y, dtype=float)

    if x.shape != y.shape or x.ndim != 2:
        raise ValueError("x and y must be equally shaped 2D arrays")

    ny, nx = x.shape

    with open(path, "w", encoding="utf-8") as handle:

        handle.write("# vtk DataFile Version 3.0\n")
        handle.write(f"{title}\n")
        handle.write("ASCII\n")
        handle.write("DATASET STRUCTURED_GRID\n")

        handle.write(
            f"DIMENSIONS {nx} {ny} 1\n"
        )

        handle.write(
            f"POINTS {nx * ny} float\n"
        )

        for j in range(ny):

            for i in range(nx):

                handle.write(
                    f"{x[j,i]:.12e} "
                    f"{y[j,i]:.12e} 0\n"
                )

        handle.write(
            f"POINT_DATA {nx * ny}\n"
        )

        for name, field in (scalars or {}).items():

            field = np.asarray(field, dtype=float)

            if field.shape != x.shape:
                raise ValueError(
                    f"Invalid dimensions for {name}"
                )

            handle.write(
                f"SCALARS {name} float 1\n"
            )

            handle.write(
                "LOOKUP_TABLE default\n"
            )

            for value in field.ravel():

                handle.write(
                    f"{value:.12e}\n"
                )

        for name, values in (vectors or {}).items():

            vx = np.asarray(values[0]).ravel()
            vy = np.asarray(values[1]).ravel()

            handle.write(
                f"VECTORS {name} float\n"
            )

            for ax, ay in zip(vx, vy):

                handle.write(
                    f"{ax:.12e} {ay:.12e} 0\n"
                )


# ================================================================
# 13. CREATE 3D WATER BODY VISUALIZATION
# ================================================================

def write_visual(
    path,
    x,
    eta,
    velocity,
    depth,
    scale,
    nz
):

    vertical_fraction = np.linspace(
        0.0,
        1.0,
        nz
    )

    xx = np.repeat(
        x[None, :],
        nz,
        axis=0
    )

    bottom = -depth * scale

    surface = eta * scale

    yy = (
        bottom
        + vertical_fraction[:, None]
        * (surface[None, :] - bottom)
    )

    eta_field = np.repeat(
        eta[None, :],
        nz,
        axis=0
    )

    velocity_field = np.repeat(
        velocity[None, :],
        nz,
        axis=0
    )

    fraction = np.repeat(
        vertical_fraction[:, None],
        x.size,
        axis=1
    )

    write_structured_grid_vtk(
        path,
        xx,
        yy,
        {
            "surface_elevation": eta_field,
            "vertical_fraction": fraction,
            "velocity_magnitude": np.abs(velocity_field)
        },
        {
            "velocity": (
                velocity_field,
                np.zeros_like(velocity_field)
            )
        },
        "Shallow water body visualization"
    )


# ================================================================
# 14. CREATE FREE SURFACE RIBBON
# ================================================================

def write_surface_ribbon(
    path,
    x,
    eta,
    scale
):

    xx = np.repeat(
        x[None, :],
        2,
        axis=0
    )

    yy = np.vstack((
        eta * scale - 0.01 * scale,
        eta * scale + 0.01 * scale
    ))

    eta_field = np.repeat(
        eta[None, :],
        2,
        axis=0
    )

    write_structured_grid_vtk(
        path,
        xx,
        yy,
        {
            "surface_elevation": eta_field
        },
        title="Lake free surface"
    )


