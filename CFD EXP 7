# ================================================================
# 2. INITIALIZE SPATIAL GRID
# ================================================================

if NX < 41:
    raise ValueError("Use at least 41 grid points.")

if LENGTH <= 0 or DEPTH <= 0 or GRAVITY <= 0:
    raise ValueError("Length, depth and gravity must be positive.")

if SIGMA <= 0 or END_TIME < 0:
    raise ValueError("Invalid wave parameters.")

if OUTPUT_EVERY < 1 or NZ_VISUAL < 3:
    raise ValueError("Invalid output parameters.")

CFL = min(0.99, max(0.01, CFL))

X = np.linspace(
    0.0,
    LENGTH,
    NX
)

DX = X[1] - X[0]

# Shallow water wave speed

WAVE_SPEED = math.sqrt(
    GRAVITY * DEPTH
)

# Time step based on CFL condition

DT_NOMINAL = (
    CFL * DX / WAVE_SPEED
)

print(f"\nSpatial step DX         : {DX:.6e}")
print(f"Wave speed              : {WAVE_SPEED:.6e} m/s")
print(f"Nominal time step       : {DT_NOMINAL:.6e} s")


# ================================================================
# 3. INITIAL GAUSSIAN WAVE
# ================================================================

def gaussian(x, center, sigma):

    return np.exp(
        -0.5 * ((x - center) / sigma)**2
    )


ETA_INITIAL = (
    AMPLITUDE
    * gaussian(X, CENTER, SIGMA)
)


# ================================================================
# 4. ANALYTICAL SOLUTION
# ================================================================

def analytical_eta(
    x,
    time,
    speed,
    amplitude,
    center,
    sigma
):

    right_wave = gaussian(
        x,
        center + speed * time,
        sigma
    )

    left_wave = gaussian(
        x,
        center - speed * time,
        sigma
    )

    return 0.5 * amplitude * (
        right_wave + left_wave
    )


# ================================================================
# 5. NUMERICAL METHODS
# ================================================================

def upwind(field, courant):

    if courant >= 0.0:

        return (
            field
            - courant * (
                field - np.roll(field, 1)
            )
        )

    else:

        return (
            field
            - courant * (
                np.roll(field, -1) - field
            )
        )


def lax_wendroff(field, courant):

    return (

        field

        - 0.5 * courant * (
            np.roll(field, -1)
            - np.roll(field, 1)
        )

        + 0.5 * courant**2 * (
            np.roll(field, -1)
            - 2.0 * field
            + np.roll(field, 1)
        )

    )


# ================================================================
# 6. RECONSTRUCT FREE SURFACE AND VELOCITY
# ================================================================

def reconstruct(
    wp,
    wm,
    depth,
    speed
):

    velocity = 0.5 * (wp + wm)

    eta = (
        depth * (wp - wm)
        / (2.0 * speed)
    )

    return eta, velocity


# ================================================================
# 7. ERROR AND MASS CALCULATIONS
# ================================================================

def relative_l2(
    numerical,
    reference
):

    numerator = np.linalg.norm(
        numerical - reference
    )

    denominator = np.linalg.norm(
        reference
    )

    return numerator / max(
        denominator,
        1e-30
    )


def trapezoidal_integral(
    values,
    coordinates
):

    return float(
        np.trapezoid(
            values,
            coordinates
        )
    )


# ================================================================
# 8. INITIALIZE BOTH NUMERICAL SCHEMES
# ================================================================

# Characteristic variables:
# W+ = u + c*eta/H
# W- = u - c*eta/H

WP_UPWIND = (
    WAVE_SPEED * ETA_INITIAL / DEPTH
)

WM_UPWIND = (
    -WAVE_SPEED * ETA_INITIAL / DEPTH
)

WP_LW = WP_UPWIND.copy()
WM_LW = WM_UPWIND.copy()

ETA_UPWIND, U_UPWIND = reconstruct(
    WP_UPWIND,
    WM_UPWIND,
    DEPTH,
    WAVE_SPEED
)

ETA_LW, U_LW = reconstruct(
    WP_LW,
    WM_LW,
    DEPTH,
    WAVE_SPEED
)

INITIAL_MASS = trapezoidal_integral(
    ETA_INITIAL,
    X
)

