def list_outputs(output_dir):
    rows = []

    for path in sorted(Path(output_dir).iterdir()):

        if path.is_file():

            size = path.stat().st_size

            if size < 1024:
                size_text = f"{size} B"

            elif size < 1024**2:
                size_text = f"{size / 1024:.1f} KB"

            else:
                size_text = f"{size / 1024**2:.1f} MB"

            rows.append((path.name, size_text))

    table = "\n".join(
        f"| `{name}` | {size} |"
        for name, size in rows
    )

    display(Markdown(
        f"### Generated files\n| File | Size |\n|---|---:|\n{table}"
    ))

    return rows


def read_structured_vtk(path):

    lines = Path(path).read_text(
        encoding="utf-8"
    ).splitlines()

    dims_index = next(
        i for i, line in enumerate(lines)
        if line.startswith("DIMENSIONS ")
    )

    _, nx, ny, nz = lines[dims_index].split()

    nx, ny, nz = int(nx), int(ny), int(nz)

    if nz != 1:
        raise ValueError("Only 2D structured VTK files are supported")

    points_index = next(
        i for i, line in enumerate(lines)
        if line.startswith("POINTS ")
    )

    npoints = int(lines[points_index].split()[1])

    points = np.array([
        [
            float(v)
            for v in lines[points_index + 1 + k].split()[:3]
        ]
        for k in range(npoints)
    ])

    x = points[:, 0].reshape(ny, nx)
    y = points[:, 1].reshape(ny, nx)

    data_index = next(
        i for i, line in enumerate(lines)
        if line.startswith("POINT_DATA ")
    ) + 1

    scalars = {}
    vectors = {}

    i = data_index

    while i < len(lines):

        if lines[i].startswith("SCALARS "):

            name = lines[i].split()[1]
            i += 2

            values = np.array([
                float(lines[i + k].split()[0])
                for k in range(npoints)
            ])

            scalars[name] = values.reshape(ny, nx)
            i += npoints

        elif lines[i].startswith("VECTORS "):

            name = lines[i].split()[1]
            i += 1

            values = np.array([
                [
                    float(v)
                    for v in lines[i + k].split()[:3]
                ]
                for k in range(npoints)
            ])

            vectors[name] = (
                values[:, 0].reshape(ny, nx),
                values[:, 1].reshape(ny, nx)
            )

            i += npoints

        else:
            i += 1

    return x, y, scalars, vectors


def plot_vtk_scalar(path, preferred_field=None):

    path = Path(path)

    if not path.is_file():
        print("VTK preview skipped")
        return

    x, y, scalars, _ = read_structured_vtk(path)

    if not scalars:
        print("No scalar field found")
        return

    field = (
        preferred_field
        if preferred_field in scalars
        else next(iter(scalars))
    )

    plt.figure(figsize=(8, 4.8))

    image = plt.contourf(
        x,
        y,
        scalars[field],
        levels=30
    )

    plt.colorbar(
        image,
        label=field.replace("_", " ")
    )

    plt.xlabel("x")
    plt.ylabel("y")

    plt.title(
        f"{field.replace('_', ' ').title()} - field preview"
    )

    plt.axis("equal")
    plt.tight_layout()
    plt.show()


def make_results_zip(output_dir, experiment_number):

    output_dir = Path(output_dir)

    archive = (
        output_dir.parent
        / f"experiment_{experiment_number:02d}_results.zip"
    )

    if archive.exists():
        archive.unlink()

    with zipfile.ZipFile(
        archive,
        "w",
        compression=zipfile.ZIP_DEFLATED
    ) as handle:

        for path in sorted(output_dir.rglob("*")):

            if path.is_file():

