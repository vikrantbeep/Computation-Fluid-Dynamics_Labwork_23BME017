def relative_l2(numerical, reference):

    a = np.asarray(numerical, dtype=float)
    b = np.asarray(reference, dtype=float)

    denominator = float(
        np.linalg.norm(b.ravel())
    )

    numerator = float(
        np.linalg.norm((a - b).ravel())
    )

    return numerator / max(denominator, 1e-30)


def tdma(a, b, c, d):

    a = np.asarray(a, dtype=float).copy()
    b = np.asarray(b, dtype=float).copy()
    c = np.asarray(c, dtype=float).copy()
    d = np.asarray(d, dtype=float).copy()

    n = d.size

    if n == 0 or a.size != n or b.size != n or c.size != n:
        raise ValueError("TDMA arrays must have equal nonzero size")

    for i in range(1, n):

        if abs(b[i - 1]) < 1e-30:
            raise FloatingPointError("Zero TDMA pivot")

        factor = a[i] / b[i - 1]

        b[i] -= factor * c[i - 1]
        d[i] -= factor * d[i - 1]

    x = np.empty(n, dtype=float)

    if abs(b[-1]) < 1e-30:
        raise FloatingPointError("Zero TDMA pivot")

    x[-1] = d[-1] / b[-1]

    for i in range(n - 2, -1, -1):

        if abs(b[i]) < 1e-30:
            raise FloatingPointError("Zero TDMA pivot")

        x[i] = (
            d[i] - c[i] * x[i + 1]
        ) / b[i]

    return x


# ================================================================
# 3. ANALYTICAL SOLUTION
# ================================================================

def analytical_profile(
    y,
    height,
    speed,
    nu,
    time,
    terms=400
):

    eta = y / height

    if time <= 0.0:

        result = np.zeros_like(y)
        result[-1] = speed

        return result

    result = eta.copy()

    for n in range(1, terms + 1):

        result += (
            2.0
            * ((-1.0) ** n)
            * np.sin(n * np.pi * eta)
            * np.exp(
                -n * n * np.pi**2 * nu * time
                / (height**2)
            )
            / (n * np.pi)
        )

    result *= speed

    result[0] = 0.0
    result[-1] = speed

    return result


# ================================================================
# 4. IMPLICIT BACKWARD EULER SOLVER
# ================================================================

def implicit_step(field, fourier, speed):

    n = field.size - 2

    a = np.full(n, -fourier)
    b = np.full(n, 1.0 + 2.0 * fourier)
    c = np.full(n, -fourier)

    rhs = field[1:-1].copy()

    rhs[-1] += fourier * speed

    a[0] = 0.0
    c[-1] = 0.0

    result = field.copy()

    result[1:-1] = tdma(
        a, b, c, rhs
    )

    result[0] = 0.0
    result[-1] = speed

    return result


