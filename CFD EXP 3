# 17. SAVE ANNULAR BOUNDARIES AND BLADE GUIDES
# ============================================================

def write_multiline_vtk(path, lines, title):
    points = []
    connectivity = []

    for line_x, line_y in lines:
        line_x = np.asarray(line_x).ravel()
        line_y = np.asarray(line_y).ravel()

        ids = list(
            range(len(points), len(points) + len(line_x))
        )

        points.extend(zip(line_x.tolist(), line_y.tolist()))
        connectivity.append(ids)

    total_size = sum(
        len(ids) + 1 for ids in connectivity
    )

    with open(path, "w", encoding="utf-8") as f:
        f.write("# vtk DataFile Version 3.0\n")
        f.write(f"{title}\n")
        f.write("ASCII\n")
        f.write("DATASET POLYDATA\n")
        f.write(f"POINTS {len(points)} float\n")

        for px, py in points:
            f.write(f"{px:.12e} {py:.12e} 0\n")

        f.write(
            f"LINES {len(connectivity)} {total_size}\n"
        )

        for ids in connectivity:
            f.write(
                f"{len(ids)} "
                + " ".join(str(i) for i in ids)
                + "\n"
            )


circle_theta = np.linspace(
    0.0, 2.0 * math.pi, 361
)

radial = np.linspace(r1, r2, 60)

boundary_lines = [
    (
        r1 * np.cos(circle_theta),
        r1 * np.sin(circle_theta)
    ),
    (
        r2 * np.cos(circle_theta),
        r2 * np.sin(circle_theta)
    )
]

write_multiline_vtk(
    OUTPUT_DIR / "pump_boundaries.vtk",
    boundary_lines,
    "Pump annular boundaries"
)

flow_guides = []

for angle in np.linspace(
    0.0, 2.0 * math.pi, 13
)[:-1]:

    flow_guides.append((
        radial * np.cos(angle),
        radial * np.sin(angle)
    ))

write_multiline_vtk(
    OUTPUT_DIR / "pump_flow_path_guides.vtk",
    flow_guides,
    "Pump radial flow guides"
)

blade_guides = []

for angle in np.linspace(
    0.0, 2.0 * math.pi, 9
)[:-1]:

    blade_angle = (
        angle
        + 0.75 * (radial - r1) / (r2 - r1)
    )

    blade_guides.append((
        radial * np.cos(blade_angle),
        radial * np.sin(blade_angle)
    ))

write_multiline_vtk(
    OUTPUT_DIR / "pump_blade_guides.vtk",
    blade_guides,
    "Pump blade guides"
)

