def run_complete_set(
    pe, nx, ny,
    iterations, output_every,
    output_dir
):

    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    case_modes = [
        "forced_plate",
        "forced_pipe",
        "natural_plate"
    ]

    rows = []

    for selected_mode in case_modes:

        case = initialize_case(
            selected_mode,
            nx,
            ny,
            pe
        )

        row = run_case(
            case,
            iterations,
            output_every,
            output_dir
        )

        rows.append(row)

    return rows


