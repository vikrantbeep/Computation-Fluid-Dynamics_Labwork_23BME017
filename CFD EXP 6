def write_structured_grid_vtk(
    filename,
    x,
    y,
    scalars
):

    ny, nx = x.shape

    with open(filename, "w") as handle:

        handle.write("# vtk DataFile Version 3.0\n")
        handle.write("2D Plate Conduction\n")
        handle.write("ASCII\n")
        handle.write("DATASET STRUCTURED_GRID\n")

        handle.write(
            f"DIMENSIONS {nx} {ny} 1\n"
        )

        handle.write(
            f"POINTS {nx * ny} float\n"
        )

        for j in range(ny):

            for i in range(nx):

                handle.write(
                    f"{x[j,i]:.12e} "
                    f"{y[j,i]:.12e} 0\n"
                )

        handle.write(
            f"POINT_DATA {nx * ny}\n"
        )

        for name, field in scalars.items():

            handle.write(
                f"SCALARS {name} float 1\n"
            )

            handle.write(
                "LOOKUP_TABLE default\n"
            )

            for value in field.ravel():

                handle.write(
                    f"{value:.12e}\n"
                )


