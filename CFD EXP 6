# ================================================================
# 1. SIMULATION PARAMETERS
# ================================================================

RUN_MODE = "lab"

# LAB PARAMETERS
NX = 81
NY = 61

L = 1.0
H = 1.0

T_LEFT = 100.0

MAX_ITERATIONS = 10000
TOLERANCE = 1e-8

OMEGA = 1.55
SCREEN_EVERY = 1000

if RUN_MODE == "quick":
    NX = 21
    NY = 21
    MAX_ITERATIONS = 30
    TOLERANCE = 1e-5
    OMEGA = 1.3
    SCREEN_EVERY = 10

OUTPUT_DIR = Path("/content/cfd_lab_exp06")
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

print("=" * 65)
print("EXPERIMENT 6: TWO-DIMENSIONAL PLATE CONDUCTION")
print("=" * 65)

print(f"Grid size              : {NX} x {NY}")
print(f"Plate length           : {L}")
print(f"Plate height           : {H}")
print(f"Left boundary temp.    : {T_LEFT}")
print(f"Maximum iterations     : {MAX_ITERATIONS}")
print(f"Convergence tolerance  : {TOLERANCE}")
print(f"SOR relaxation factor  : {OMEGA}")

# ================================================================
# 2. COMPUTATIONAL GRID
# ================================================================

x1 = np.linspace(0.0, L, NX)
y1 = np.linspace(0.0, H, NY)

X, Y = np.meshgrid(x1, y1)

DX = x1[1] - x1[0]
DY = y1[1] - y1[0]

BETA = (DX / DY)**2

print(f"\nDX = {DX:.6e}")
print(f"DY = {DY:.6e}")
print(f"Beta = {BETA:.6e}")

# ================================================================
# 3. ANALYTICAL SOLUTION
# ================================================================

def analytical_solution(x, y):

    denominator = math.sinh(math.pi * L / H)

    return (
        T_LEFT
        * np.sinh(math.pi * (L - x) / H)
        * np.sin(math.pi * y / H)
        / denominator
    )


T_ANALYTICAL = analytical_solution(X, Y)

# ================================================================
# 4. BOUNDARY CONDITIONS
# ================================================================

def apply_boundaries(T):

    # Left boundary
    T[:, 0] = T_LEFT * np.sin(math.pi * y1 / H)

    # Right boundary
    T[:, -1] = 0.0

    # Bottom boundary
    T[0, :] = 0.0

    # Top boundary
    T[-1, :] = 0.0


# ================================================================
# 5. TDMA SOLVER
# ================================================================

def tdma(a, b, c, d):

    a = np.asarray(a, dtype=float).copy()
    b = np.asarray(b, dtype=float).copy()
    c = np.asarray(c, dtype=float).copy()
    d = np.asarray(d, dtype=float).copy()

    n = len(d)

    if n == 0:
        raise ValueError("TDMA system is empty")

    # Forward elimination

    for i in range(1, n):

        if abs(b[i-1]) < 1e-30:
            raise FloatingPointError("Zero TDMA pivot")

        factor = a[i] / b[i-1]

        b[i] -= factor * c[i-1]
        d[i] -= factor * d[i-1]

    # Back substitution

    solution = np.zeros(n)

    if abs(b[-1]) < 1e-30:
        raise FloatingPointError("Zero TDMA pivot")

    solution[-1] = d[-1] / b[-1]

    for i in range(n-2, -1, -1):

        if abs(b[i]) < 1e-30:
            raise FloatingPointError("Zero TDMA pivot")

        solution[i] = (
            d[i] - c[i] * solution[i+1]
        ) / b[i]

    return solution


# ================================================================
# 6. RELATIVE L2 ERROR
# ================================================================

def relative_l2(numerical, reference):

    numerator = np.linalg.norm(
        (numerical - reference).ravel()
    )

    denominator = np.linalg.norm(
        reference.ravel()
    )

    return numerator / max(denominator, 1e-30)


# ================================================================
# 7. INITIALIZE JACOBI AND LINE-TDMA SOLUTIONS
# ================================================================

T_JACOBI = np.zeros((NY, NX))

T_LINE_TDMA = np.zeros((NY, NX))

apply_boundaries(T_JACOBI)
apply_boundaries(T_LINE_TDMA)

JACOBI_HISTORY = []
TDMA_HISTORY = []

# ================================================================
# 8. JACOBI ITERATIVE METHOD
# ================================================================

print("\n" + "=" * 65)
print("STARTING JACOBI METHOD")
print("=" * 65)

JACOBI_ITERATIONS = MAX_ITERATIONS
JACOBI_RESIDUAL = float("inf")

for iteration in range(1, MAX_ITERATIONS + 1):

    OLD = T_JACOBI.copy()

    # Finite difference Laplace equation

    T_JACOBI[1:-1, 1:-1] = (

        OLD[1:-1, 2:]
        + OLD[1:-1, :-2]

        + BETA * (
            OLD[2:, 1:-1]
            + OLD[:-2, 1:-1]
        )

    ) / (2.0 * (1.0 + BETA))

    # Reapply boundary conditions

    apply_boundaries(T_JACOBI)

    # Residual: maximum change between iterations

    JACOBI_RESIDUAL = np.max(
        np.abs(T_JACOBI - OLD)
    )

    ERROR = relative_l2(
        T_JACOBI,
        T_ANALYTICAL
    )

    JACOBI_HISTORY.append([
        iteration,
        JACOBI_RESIDUAL,
        ERROR
    ])

    if (
        iteration == 1
        or iteration == MAX_ITERATIONS
        or iteration % SCREEN_EVERY == 0
    ):

        print(
            f"Jacobi Iteration: {iteration:6d} | "
            f"Residual: {JACOBI_RESIDUAL:.6e} | "
            f"L2 Error: {ERROR:.6e}"
        )

    if JACOBI_RESIDUAL < TOLERANCE:

        JACOBI_ITERATIONS = iteration
        break


# ================================================================
# 9. LINE-TDMA / SOR METHOD
# ================================================================

print("\n" + "=" * 65)
print("STARTING LINE-TDMA / SOR METHOD")
print("=" * 65)

TDMA_ITERATIONS = MAX_ITERATIONS
TDMA_RESIDUAL = float("inf")

N_UNKNOWN = NX - 2

for iteration in range(1, MAX_ITERATIONS + 1):

    OLD_ITERATION = T_LINE_TDMA.copy()

    # Sweep along horizontal lines

    for j in range(1, NY - 1):

        a = np.full(
            N_UNKNOWN,
            -1.0
        )

        b = np.full(
            N_UNKNOWN,
            2.0 * (1.0 + BETA)
        )

        c = np.full(
            N_UNKNOWN,
            -1.0
        )

        # Right-hand side

        rhs = BETA * (
            T_LINE_TDMA[j+1, 1:-1]
            + T_LINE_TDMA[j-1, 1:-1]
        )

        rhs[0] += T_LINE_TDMA[j, 0]

        rhs[-1] += T_LINE_TDMA[j, -1]

        a[0] = 0.0
        c[-1] = 0.0

        # Solve using TDMA

        SOLVED = tdma(
            a, b, c, rhs
        )

        # SOR relaxation

        T_LINE_TDMA[j, 1:-1] = (

            (1.0 - OMEGA)
            * T_LINE_TDMA[j, 1:-1]

            + OMEGA * SOLVED

        )

    apply_boundaries(T_LINE_TDMA)

    TDMA_RESIDUAL = np.max(
        np.abs(
            T_LINE_TDMA - OLD_ITERATION
        )
    )

    ERROR = relative_l2(
        T_LINE_TDMA,
        T_ANALYTICAL
    )

    TDMA_HISTORY.append([
        iteration,
        TDMA_RESIDUAL,
        ERROR
    ])

    if (
        iteration == 1
        or iteration == MAX_ITERATIONS
        or iteration % SCREEN_EVERY == 0
    ):

        print(
            f"Line-TDMA Iteration: {iteration:6d} | "
            f"Residual: {TDMA_RESIDUAL:.6e} | "
            f"L2 Error: {ERROR:.6e}"
        )

    if TDMA_RESIDUAL < TOLERANCE:

        TDMA_ITERATIONS = iteration
        break


# ================================================================
# 10. CALCULATE FINAL ERRORS
# ================================================================

JACOBI_ERROR = relative_l2(
    T_JACOBI,
    T_ANALYTICAL
)

TDMA_ERROR = relative_l2(
    T_LINE_TDMA,
    T_ANALYTICAL
)

JACOBI_MAX_ERROR = np.max(
    np.abs(T_JACOBI - T_ANALYTICAL)
)

TDMA_MAX_ERROR = np.max(
    np.abs(T_LINE_TDMA - T_ANALYTICAL)
)

print("\n" + "=" * 65)
print("FINAL NUMERICAL RESULTS")
print("=" * 65)

print(
