def run_solver(
    n_radial, vtk_nx, vtk_ny,
    Re_min, Re_max, n_Re,
    max_iterations, tolerance,
    output_dir
):

    output_dir = Path(output_dir)
    output_dir.mkdir(parents=True, exist_ok=True)

    if (
        n_radial < 21 or
        vtk_nx < 10 or
        vtk_ny < 11 or
        Re_min <= 0 or
        Re_max < Re_min or
        n_Re < 1 or
        max_iterations < 1 or
        tolerance <= 0
    ):

        raise ValueError("Invalid simulation parameters.")

    models = [
        (0, "laminar"),
        (1, "mixing_length"),
        (2, "van_driest"),
        (3, "kepsilon"),
        (4, "komega_sst")
    ]

    if n_Re == 1:
        reynolds_values = np.array([Re_min])
    else:
        reynolds_values = np.geomspace(
            Re_min, Re_max, n_Re
        )

    summary_rows = []

    all_results = {}

    for reynolds in reynolds_values:

        results = []

        print("\n"+"="*70)
        print(f"REYNOLDS NUMBER: {reynolds:.2f}")
        print("="*70)

        for model, name in models:

            result = solve_model(
                model,
                name,
                n_radial,
                float(reynolds),
                max_iterations,
                tolerance
            )

            results.append(result)

            all_results[
                (float(reynolds), name)
            ] = result

            blasius = (
                0.3164*reynolds**(-0.25)
            )

            haaland = (
                1.0/(
                    -1.8*np.log10(6.9/reynolds)
                )**2
            )

            summary_rows.append([
                reynolds,
                name,
                result.friction,
                blasius,
                haaland,
                result.u_tau,
                result.pressure_drop,
                result.velocity[0],
                np.max(result.nut/result.nu),
                result.iterations,
                result.residual
            ])

            print(
                f"{name:15s} | "
                f"friction = {result.friction:.6e} | "
                f"U_center = {result.velocity[0]:.6e} | "
                f"residual = {result.residual:.6e}"
            )

        # --------------------------------------------------------
        # 2D EXTRUDED PIPE FIELD
        # --------------------------------------------------------

        x1 = np.linspace(0.0, 10.0, vtk_nx)
        y1 = np.linspace(-0.5, 0.5, vtk_ny)

        x, y = np.meshgrid(x1, y1)

        radial_position = np.abs(y)

        scalars = {}
        vectors = {}

        for result in results:

            velocity_profile = radial_interpolate(
                result, radial_position
            )

            nut_ratio = interpolate_field(
                result.radius,
                result.nut/result.nu,
                radial_position
            )

            k_field = interpolate_field(
                result.radius,
                result.k,
                radial_position
            )

            epsilon_field = interpolate_field(
                result.radius,
                result.epsilon,
                radial_position
            )

            omega_field = interpolate_field(
                result.radius,
                result.omega,
                radial_position
            )

            pressure = (
                result.pressure_drop
                *(1.0-x/10.0)
            )

            scalars[f"U_{result.name}"] = velocity_profile

            scalars[
                f"nut_over_nu_{result.name}"
            ] = nut_ratio

            scalars[f"pressure_{result.name}"] = pressure
            scalars[f"k_{result.name}"] = k_field

            scalars[
                f"epsilon_{result.name}"
            ] = epsilon_field

            scalars[
                f"omega_{result.name}"
            ] = omega_field

            vectors[
                f"velocity_{result.name}"
            ] = (
                velocity_profile,
                np.zeros_like(velocity_profile)
            )

        tag = f"{reynolds:.0f}"

        write_structured_grid_vtk(
            output_dir/f"pipe2d_compare_Re{tag}.vtk",
            x, y,
            scalars,
            vectors,
            "2D axisymmetric pipe turbulence-model comparison"
        )

        # --------------------------------------------------------
        # PROFILE CSV
        # --------------------------------------------------------

        with open(
            output_dir/f"pipe2d_profiles_Re{tag}.csv",
            "w",
            newline=""
        ) as f:

            writer = csv.writer(f)

            header = ["r_over_R"]

            for result in results:

                header.extend([
                    f"U_{result.name}",
                    f"nut_over_nu_{result.name}",
                    f"k_{result.name}",
                    f"epsilon_{result.name}",
                    f"omega_{result.name}"
                ])

            writer.writerow(header)

            for i in range(n_radial):

                row = [
                    results[0].radius[i]/0.5
                ]

                for result in results:

                    row.extend([
                        result.velocity[i],
                        result.nut[i]/result.nu,
                        result.k[i],
                        result.epsilon[i],
                        result.omega[i]
                    ])

                writer.writerow(row)

    # ============================================================
    # 8. SUMMARY CSV
    # ============================================================

    with open(
        output_dir/"pipe2d_rans_summary.csv",
        "w",
        newline=""
    ) as f:

        writer = csv.writer(f)

        writer.writerow([
            "Re",
            "model",
            "friction_factor_Darcy",
            "Blasius_reference",
            "Haaland_smooth_reference",
            "uTau",
            "pressure_drop_over_10D",
            "U_center",
            "maximum_nut_over_nu",
            "iterations",
            "residual"
        ])

        writer.writerows(summary_rows)

    # Pipe wall VTK
    write_multiline_vtk(
        output_dir/"pipe2d_walls.vtk",
        [
            (
                np.array([0.0, 10.0]),
                np.array([-0.5, -0.5])
            ),
            (
                np.array([0.0, 10.0]),
                np.array([0.5, 0.5])
            )
        ]
    )

    summary_text = """
TURBULENT PIPE-FLOW MODEL COMPARISON

Models:
1. Laminar
2. Mixing Length
3. Van Driest
4. Equilibrium k-epsilon
5. Equilibrium k-omega / SST surrogate

The model solves radial eddy-viscosity closures
and extrudes the profile along the pipe axis.

This is a teaching-level 2D axisymmetric fully
developed pipe-flow model.

It is NOT a full industrial two-equation RANS
transport solver.

Compare friction factors with Blasius and
Haaland reference values in the summary CSV.
"""

    (output_dir/"pipe2d_rans_summary.txt").write_text(
        summary_text
    )

    print("\nSolver completed.")
    print(summary_text)

    return all_results, summary_rows


