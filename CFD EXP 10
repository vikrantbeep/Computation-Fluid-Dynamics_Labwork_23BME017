def tdma(a, b, c, d):

    a = np.asarray(a, dtype=float).copy()
    b = np.asarray(b, dtype=float).copy()
    c = np.asarray(c, dtype=float).copy()
    d = np.asarray(d, dtype=float).copy()

    n = d.size

    if n == 0 or any(arr.size != n for arr in [a, b, c]):
        raise ValueError("TDMA arrays must have equal nonzero size")

    for i in range(1, n):

        if abs(b[i-1]) < 1e-30:
            raise FloatingPointError("Zero TDMA pivot")

        factor = a[i] / b[i-1]

        b[i] -= factor*c[i-1]
        d[i] -= factor*d[i-1]

    x = np.empty(n)

    if abs(b[-1]) < 1e-30:
        raise FloatingPointError("Zero TDMA pivot")

    x[-1] = d[-1]/b[-1]

    for i in range(n-2, -1, -1):

        if abs(b[i]) < 1e-30:
            raise FloatingPointError("Zero TDMA pivot")

        x[i] = (
            d[i] - c[i]*x[i+1]
        )/b[i]

    return x


def bulk_velocity(radius, velocity, pipe_radius, dr):

    return (
        2.0*np.sum(velocity*radius)*dr
        /(pipe_radius**2)
    )


def relative_l2(numerical, reference):

    denominator = np.linalg.norm(reference.ravel())
    numerator = np.linalg.norm(
        (numerical-reference).ravel()
    )

    return numerator/max(denominator, 1e-30)


# ================================================================
# 4. TURBULENCE MODEL SOLVER
# ================================================================

class ModelResult:

    def __init__(
        self, name, reynolds, nu, friction,
        u_tau, pressure_drop, residual,
        iterations, radius, velocity,
        nut, k, epsilon, omega
    ):

        self.name = name
        self.reynolds = reynolds
        self.nu = nu
        self.friction = friction
        self.u_tau = u_tau
        self.pressure_drop = pressure_drop
        self.residual = residual
        self.iterations = iterations
        self.radius = radius
        self.velocity = velocity
        self.nut = nut
        self.k = k
        self.epsilon = epsilon
        self.omega = omega


def solve_model(
    model, name, n, reynolds,
    max_iterations, tolerance
):

    pipe_radius = 0.5
    diameter = 1.0
    target_bulk = 1.0

    nu = target_bulk*diameter/reynolds

    dr = pipe_radius/n

    radius = (np.arange(n)+0.5)*dr

    velocity = 2.0*(
        1.0-(radius/pipe_radius)**2
    )

    nut = np.zeros(n)
    k = np.zeros(n)
    epsilon = np.zeros(n)
    omega_field = np.zeros(n)

    kappa = 0.41
    a_plus = 26.0
    c_mu = 0.09
    beta_star = 0.09
    a1 = 0.31

    friction_initial = (
        0.3164*max(reynolds, 4000.0)**(-0.25)
    )

    u_tau = math.sqrt(
        max(friction_initial/8.0, 1e-12)
    )

    residual = 1.0
    completed = 0

    for iteration in range(1, max_iterations+1):

        old = velocity.copy()

        derivative = np.gradient(
            velocity, dr, edge_order=2
        )

        wall_distance = np.maximum(
            pipe_radius-radius, 0.5*dr
        )

        y_plus = wall_distance*u_tau/nu

        damping = 1.0-np.exp(-y_plus/a_plus)

        strain = np.abs(derivative)

        k.fill(0.0)
        epsilon.fill(0.0)
        omega_field.fill(0.0)

        # --------------------------------------------------------
        # MODEL 0: LAMINAR
        # --------------------------------------------------------

        if model == 0:

            nut.fill(0.0)

        # --------------------------------------------------------
        # MODEL 1: MIXING LENGTH
        # --------------------------------------------------------

        elif model == 1:

            mixing_length = kappa*wall_distance

            nut = mixing_length**2*strain

        # --------------------------------------------------------
        # MODEL 2: VAN DRIEST
        # --------------------------------------------------------

        elif model == 2:

            mixing_length = (
                kappa*wall_distance*damping
            )

            nut = mixing_length**2*strain

        # --------------------------------------------------------
        # MODEL 3: EQUILIBRIUM K-EPSILON
        # --------------------------------------------------------

        elif model == 3:

            kdamp = 1.0-np.exp(-y_plus/12.0)

            k = (
                u_tau**2/math.sqrt(c_mu)
            )*kdamp**2

            y_use = np.maximum(
                wall_distance,
                1.5*nu/max(u_tau, 1e-12)
            )

            epsilon = (
                c_mu**0.75
                *np.maximum(k, 1e-16)**1.5
                /(kappa*y_use)
            )

            nut = (
                c_mu*k**2
                /np.maximum(epsilon, 1e-18)
                *damping**2
            )

        # --------------------------------------------------------
        # MODEL 4: EQUILIBRIUM K-OMEGA / SST SURROGATE
        # --------------------------------------------------------

        elif model == 4:

            kdamp = 1.0-np.exp(-y_plus/10.0)

            k = (
                u_tau**2/math.sqrt(beta_star)
            )*kdamp**2

            y_use = np.maximum(
                wall_distance,
                1.5*nu/max(u_tau, 1e-12)
            )

            omega_field = (
                u_tau
                /(math.sqrt(beta_star)*kappa*y_use)
            )

            f2_arg = (
                2.0*np.sqrt(np.maximum(k, 0.0))
                /np.maximum(
                    beta_star*omega_field*y_use,
                    1e-18
                )
            )

            f2 = np.tanh(
                np.maximum(f2_arg, 0.0)**2
            )

            denominator = np.maximum(
                a1*omega_field,
                strain*f2
            )

            nut = (
                a1*k
                /np.maximum(denominator, 1e-18)
                *damping**2
            )

            epsilon = beta_star*k*omega_field

        else:

            raise ValueError("Unknown turbulence model")

        # Limit eddy viscosity
        nut = np.clip(nut, 0.0, 300.0*nu)

        effective = nu+nut

        # --------------------------------------------------------
        # RADIAL MOMENTUM EQUATION
        # --------------------------------------------------------

        a = np.zeros(n)
        b = np.zeros(n)
        c = np.zeros(n)

        rhs = radius*dr

        for i in range(n):

            diagonal = 0.0

            if i > 0:

                rw = i*dr

                nuw = 0.5*(
                    effective[i]+effective[i-1]
                )

                aw = rw*nuw/dr

                a[i] = -aw
                diagonal += aw

            re = (i+1)*dr

            if i < n-1:

                nue = 0.5*(
                    effective[i]+effective[i+1]
                )

                ae = re*nue/dr

                c[i] = -ae
                diagonal += ae

            else:

                ae = re*nu/(0.5*dr)

                diagonal += ae

            b[i] = diagonal

        candidate = tdma(a, b, c, rhs)

        # Maintain unit bulk velocity
        candidate *= (
            target_bulk
            /max(
                bulk_velocity(
                    radius, candidate,
                    pipe_radius, dr
                ),
                1e-30
            )
        )

        # Wall friction velocity
        wall_gradient = (
            0.0-candidate[-1]
        )/(0.5*dr)

        new_u_tau = math.sqrt(
            max(nu*abs(wall_gradient), 1e-18)
        )

        relax = 1.0 if model == 0 else 0.45

        velocity = (
            relax*candidate
            +(1.0-relax)*velocity
        )

        residual = (
            np.linalg.norm(velocity-old)
            /max(np.linalg.norm(old), 1e-30)
        )

        u_tau = (
            0.35*new_u_tau+0.65*u_tau
        )

        completed = iteration

        if residual < tolerance and iteration > 20:
            break

    friction = 8.0*u_tau**2

    pressure_drop = friction*10.0*0.5

    return ModelResult(
        name, reynolds, nu,
        friction, u_tau, pressure_drop,
        residual, completed,
        radius, velocity, nut,
        k, epsilon, omega_field
    )


# ================================================================
# 5. INTERPOLATION
# ================================================================

def radial_interpolate(result, radial_position):

    pipe_radius = 0.5

    xp = np.concatenate((
        [0.0],
        result.radius,
        [pipe_radius]
    ))

    fp = np.concatenate((
        [result.velocity[0]],
        result.velocity,
        [0.0]
    ))

    return np.interp(radial_position, xp, fp)


def interpolate_field(
    radius, values, radial_position,
    wall_value=0.0
):

    pipe_radius = 0.5

    xp = np.concatenate((
        [0.0], radius, [pipe_radius]
    ))

    fp = np.concatenate((
        [values[0]], values, [wall_value]
    ))

    return np.interp(radial_position, xp, fp)


