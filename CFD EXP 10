# 14. INLINE VTK FIELD VISUALIZATION
# ================================================================

def read_vtk_scalar(path, field_name):

    lines = Path(path).read_text().splitlines()

    dims_index = next(
        i for i, line in enumerate(lines)
        if line.startswith("DIMENSIONS ")
    )

    _, nx, ny, nz = lines[dims_index].split()

    nx, ny = int(nx), int(ny)

    points_index = next(
        i for i, line in enumerate(lines)
        if line.startswith("POINTS ")
    )

    npoints = int(lines[points_index].split()[1])

    points = np.array([
        [
            float(v)
            for v in lines[points_index+1+k].split()[:3]
        ]
        for k in range(npoints)
    ])

    x = points[:, 0].reshape(ny, nx)
    y = points[:, 1].reshape(ny, nx)

    field_index = next(
        i for i, line in enumerate(lines)
        if line.startswith(f"SCALARS {field_name} ")
    )

    values_start = field_index+2

    values = np.array([
        float(lines[values_start+k].split()[0])
        for k in range(npoints)
    ])

    return x, y, values.reshape(ny, nx)


